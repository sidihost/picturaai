# =============================================================================
# PICTURA AI - Environment Variables Template
# =============================================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control!
# =============================================================================

# =============================================================================
# DATABASE
# =============================================================================
# Neon PostgreSQL connection string
# Get this from your Neon dashboard: https://neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx-xxx-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# =============================================================================
# SESSION
# =============================================================================
# Session versioning (increment this if you need to invalidate all sessions)
SESSION_EPOCH=v1

# =============================================================================
# AI PROVIDERS - Configure at least one!
# =============================================================================

# Mistral AI (Recommended - Primary Provider)
# Sign up at: https://console.mistral.ai/
MISTRAL_API_KEY=

# OpenAI (DALL-E 3)
# Sign up at: https://platform.openai.com/
OPENAI_API_KEY=

# Alibaba Cloud / DashScope
# Sign up at: https://dashscope.console.aliyun.com/
ALIBABA_API_KEY=
DASHSCOPE_API_KEY=

# Replicate (Flux models)
# Sign up at: https://replicate.com/
REPLICATE_API_TOKEN=

# Together AI
# Sign up at: https://together.xyz/
TOGETHER_API_KEY=

# Fireworks AI
# Sign up at: https://fireworks.ai/
FIREWORKS_API_KEY=

# DeepInfra
# Sign up at: https://deepinfra.com/
DEEPINFRA_API_KEY=

# Fal AI
# Sign up at: https://fal.run/
FAL_KEY=

# =============================================================================
# STORAGE - Vercel Blob (default)
# =============================================================================
# Get this from your Vercel dashboard: https://vercel.com/dashboard
BLOB_READ_WRITE_TOKEN=

# =============================================================================
# STORAGE - Cloudflare R2 (alternative)
# =============================================================================
# If R2 is configured, it will be used instead of Vercel Blob
# Sign up for Cloudflare R2 at: https://dash.cloudflare.com/
CF_R2_BUCKET_NAME=
CF_R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
# Optional: Custom public domain for R2
CF_R2_PUBLIC_DOMAIN=

# =============================================================================
# EMAIL - ZeptoMail
# =============================================================================
# Sign up at: https://zeptomail.com/
ZEPTO_MAIL_USERNAME=emailapikey
ZEPTO_MAIL_PASSWORD=

# =============================================================================
# CAPTCHA - Cloudflare Turnstile
# =============================================================================
# Sign up at: https://dash.cloudflare.com/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# =============================================================================
# ADMIN AUTHENTICATION
# =============================================================================
# Secret key for admin panel authentication
# Generate a secure random string: openssl rand -hex 32
ADMIN_SECRET_KEY=

# =============================================================================
# ANALYTICS (Optional)
# =============================================================================
# Vercel provides these automatically when deployed to Vercel
# VERCEL_URL=https://your-domain.com

# =============================================================================
# PAYMENT PROVIDERS (Optional)
# =============================================================================
# Paystack
# PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=

# KoraPay
# KORAPAY_SECRET_KEY=
# KORAPAY_PUBLIC_KEY=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Node environment
NODE_ENV=development

# Application URL (used for redirects and emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
